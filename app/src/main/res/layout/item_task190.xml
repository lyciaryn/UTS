<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTaskItem190"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/card_stroke_190"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <CheckBox
            android:id="@+id/cbTaskDone190"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:buttonTint="@color/primary_190" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvNamaTugas190"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Nama Tugas Contoh"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_190" />

                <TextView
                    android:id="@+id/tvPriority190"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tinggi"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/priority_high_190"
                    android:background="@drawable/bg_priority_high_190"
                    android:layout_marginStart="8dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDeadline190"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Deadline: 2025-03-30"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_190"
                android:layout_marginTop="6dp" />

        </LinearLayout>

        <ImageButton
            android:id="@+id/btnEdit190"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/edit_task_190"
            android:src="@android:drawable/ic_menu_edit"
            app:tint="@color/primary_190" />

        <ImageButton
            android:id="@+id/btnDelete190"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete_190"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#DC2626" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
